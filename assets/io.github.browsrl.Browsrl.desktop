[Desktop Entry]
Type=Application
Name=Browsrl
GenericName=Web Browser
Comment=A small local-first browser shell for GTK desktops
Exec=browsrl %u
Icon=browsrl
Terminal=false
Categories=Network;WebBrowser;
Keywords=web;browser;internet;
StartupNotify=true
StartupWMClass=io.github.browsrl.Browsrl
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
